generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String   @id @default(uuid())
  name        String   @unique
  role        String   @default("buyer")
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  description String?  @db.Text
  website     String?
  phone       String?
  avatarUrl   String?
  coverUrl    String?
  socialLinks Json?

  // ── Локация ──
  city               String?

  // ── Верификация компании ──
  inn                String?   @unique
  ogrn               String?
  kpp                String?
  companyType        String?   // ООО, ИП, АО и т.д.
  legalAddress       String?
  directorName       String?
  verificationStatus String    @default("none") // none, pending, verified, rejected
  verificationDocs   String[]  // URL сканов выписки из ЕГРЮЛ/ЕГРИП
  verificationData   Json?     // ответ DaData (полные реквизиты)
  submittedAt        DateTime?
  verifiedAt         DateTime?
  rejectedReason     String?

  // ── Условия торговли ──
  deliveryMethods    String[]  // Способы доставки
  paymentMethods     String[]  // Способы оплаты

  users                 User[]
  products              Product[]
  rfqs                  Rfq[]     @relation("BuyerRfqs")
  quotes                Quote[]   @relation("SellerQuotes")
  sentMessages          Message[] @relation("MessageSender")
  receivedNotifications Notification[] @relation("RecipientNotifications")
  reportMessages        ReportMessage[] @relation("ReportMessageSender")
  reviews               Review[]  @relation("TenantReviews")
  authoredReviews       Review[]  @relation("AuthorReviews")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  isActive      Boolean        @default(true)
  isAdmin       Boolean        @default(false)
  createdAt     DateTime       @default(now())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  ip        String?
  userAgent String?
}

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]
  rfqs      Rfq[]
  createdAt DateTime   @default(now())
}

model Product {
  id          String    @id @default(uuid())
  name        String
  description String?   @db.Text
  price       Decimal   @db.Decimal(10, 2)
  unit        String    @default("шт.")
  stock       Int       @default(0)
  isOpt       Boolean   @default(true)
  isRetail    Boolean   @default(false)
  images      String[] // массив URL изображений
  viewCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  messages Message[]
  views    ProductView[]
}

model Rfq {
  id          String    @id @default(uuid())
  title       String
  description String
  quantity    Int
  budget      Decimal?  @db.Decimal(10, 2)
  deadline    DateTime?
  status      String    @default("open")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  buyerId String
  buyer   Tenant @relation("BuyerRfqs", fields: [buyerId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  unit     String?

  quotes   Quote[]
  messages Message[]
}

model Quote {
  id           String    @id @default(uuid())
  price        Decimal   @db.Decimal(10, 2)
  deliveryTime String?
  message      String?
  status       String    @default("pending")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  rfqId String
  rfq   Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  sellerId String
  seller   Tenant @relation("SellerQuotes", fields: [sellerId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  text      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation("TenantReviews", fields: [tenantId], references: [id], onDelete: Cascade)

  authorId String
  author   Tenant @relation("AuthorReviews", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([tenantId, authorId])
  @@index([tenantId])
  @@index([authorId])
}

model ProductView {
  id        String   @id @default(uuid())
  productId String
  tenantId  String
  ip        String
  date      String   // YYYY-MM-DD
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, ip, date])
  @@index([tenantId, date])
  @@index([productId])
}

model Message {
  id        String    @id @default(uuid())
  content   String
  isEdited  Boolean   @default(false)
  editedAt  DateTime?
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())

  senderId String
  sender   Tenant @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  rfqId String?
  rfq   Rfq?    @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Report {
  id          String   @id @default(uuid())
  type        String
  targetId    String
  targetName  String?
  targetLink  String?
  reason      String
  description String?
  screenshots String[]
  status      String   @default("pending")
  reporterId  String
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?

  messages    ReportMessage[]
}

model ReportMessage {
  id         String   @id @default(uuid())
  content    String
  createdAt  DateTime @default(now())
  isDeleted  Boolean  @default(false)
  senderType String   @default("user")

  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  senderId String
  sender   Tenant @relation("ReportMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(uuid())
  title       String
  message     String
  type        String   @default("system")
  isRead      Boolean  @default(false)
  link        String?
  metadata    Json?
  createdAt   DateTime @default(now())

  recipientId String
  recipient   Tenant @relation("RecipientNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
}
