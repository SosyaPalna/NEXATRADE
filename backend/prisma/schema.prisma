generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id         String      @id @default(uuid())
  name       String      @unique
  role       String      @default("buyer")
  isVerified Boolean     @default(false)
  createdAt  DateTime    @default(now())

  users      User[]
  products   Product[]
  rfqs       Rfq[]       @relation("BuyerRfqs")
  quotes     Quote[]     @relation("SellerQuotes")
  sentMessages Message[] @relation("MessageSender") // ← ОБРАТНАЯ СВЯЗЬ
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  category    String   @default("general")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Rfq {
  id          String      @id @default(uuid())
  title       String
  description String
  quantity    Int
  budget      Decimal?    @db.Decimal(10, 2)
  deadline    DateTime?
  status      String      @default("open")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  buyerId     String
  buyer       Tenant      @relation("BuyerRfqs", fields: [buyerId], references: [id], onDelete: Cascade)

  quotes      Quote[]
  messages    Message[]   // ← ОБРАТНАЯ СВЯЗЬ
}

model Quote {
  id           String   @id @default(uuid())
  price        Decimal  @db.Decimal(10, 2)
  deliveryTime String?
  message      String?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rfqId        String
  rfq          Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  sellerId     String
  seller       Tenant   @relation("SellerQuotes", fields: [sellerId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  senderId  String
  sender    Tenant   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  rfqId     String
  rfq       Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
}