generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String   @id @default(uuid())
  name        String   @unique
  role        String   @default("buyer")
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  description String?  @db.Text
  website     String?
  phone       String?
  avatarUrl   String?
  coverUrl    String?
  socialLinks Json?

  users                 User[]
  products              Product[]
  rfqs                  Rfq[]     @relation("BuyerRfqs")
  quotes                Quote[]   @relation("SellerQuotes")
  sentMessages          Message[] @relation("MessageSender")
  receivedNotifications Notification[] @relation("RecipientNotifications")
  reportMessages        ReportMessage[] @relation("ReportMessageSender")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  isActive  Boolean  @default(true)
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]
  rfqs      Rfq[]
  createdAt DateTime   @default(now())
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  unit        String   @default("шт.")
  stock       Int      @default(0)
  isOpt       Boolean  @default(true)
  isRetail    Boolean  @default(false)
  images      String[] // массив URL изображений
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  messages Message[]
}

model Rfq {
  id          String    @id @default(uuid())
  title       String
  description String
  quantity    Int
  budget      Decimal?  @db.Decimal(10, 2)
  deadline    DateTime?
  status      String    @default("open")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  buyerId String
  buyer   Tenant @relation("BuyerRfqs", fields: [buyerId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  unit     String?

  quotes   Quote[]
  messages Message[]
}

model Quote {
  id           String   @id @default(uuid())
  price        Decimal  @db.Decimal(10, 2)
  deliveryTime String?
  message      String?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rfqId String
  rfq   Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  sellerId String
  seller   Tenant @relation("SellerQuotes", fields: [sellerId], references: [id], onDelete: Cascade)
}

model Message {
  id        String    @id @default(uuid())
  content   String
  isEdited  Boolean   @default(false)
  editedAt  DateTime?
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())

  senderId String
  sender   Tenant @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  rfqId String?
  rfq   Rfq?    @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Report {
  id          String   @id @default(uuid())
  type        String
  targetId    String
  targetName  String?
  targetLink  String?
  reason      String
  description String?
  screenshots String[]
  status      String   @default("pending")
  reporterId  String
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?

  messages    ReportMessage[]
}

model ReportMessage {
  id         String   @id @default(uuid())
  content    String
  createdAt  DateTime @default(now())
  isDeleted  Boolean  @default(false)
  senderType String   @default("user")

  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  senderId String
  sender   Tenant @relation("ReportMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(uuid())
  title       String
  message     String
  type        String   @default("system")
  isRead      Boolean  @default(false)
  link        String?
  metadata    Json?
  createdAt   DateTime @default(now())

  recipientId String
  recipient   Tenant @relation("RecipientNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
}
