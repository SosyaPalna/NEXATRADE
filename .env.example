# ============================================================
# NexaTrade — Production Environment Variables
# ============================================================
# Скопируй этот файл в backend/.env и заполни реальными значениями

# PostgreSQL Database
DATABASE_URL="postgresql://user:password@localhost:5432/nexatrade_db?schema=public"

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server
PORT=8000
NODE_ENV=production

# Frontend URL (for CORS)
FRONTEND_URL="https://your-domain.com"

# Optional: Admin seed credentials (for first-run setup)
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="changeme"

# Prerender.io token (для SEO — отдаёт поисковикам статический HTML)
# Получить бесплатный токен: https://prerender.io
# PRERENDER_TOKEN="your-prerender-token"
