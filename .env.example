# ============================================================
# NexaTrade — Production Environment Variables
# ============================================================
# Скопируй этот файл в backend/.env и заполни реальными значениями

# PostgreSQL Database
DATABASE_URL="postgresql://user:password@localhost:5432/nexatrade_db?schema=public"

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server
PORT=8000
NODE_ENV=production

# Frontend URL (for CORS)
FRONTEND_URL="https://your-domain.com"

# Optional: Admin seed credentials (for first-run setup)
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="changeme"

# DaData API key (верификация компаний по ИНН)
# Получить бесплатно: https://dadata.ru
# DADATA_API_KEY="your-dadata-api-key"

# Optional: trusted IPs exempt from login rate limiter (comma-separated)
# LOGIN_LIMITER_TRUSTED_IPS="92.124.160.42,92.124.161.33"
